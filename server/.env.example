# ============================================================
# Bucketeer settings — the only file you ever need to edit
# ============================================================
# (If you're reading .env.example: running `npm run dev` once creates
# your real copy at server/.env automatically. Edit THAT one.)
#
# This file stays on YOUR computer. It is git-ignored and its contents
# are never sent to the browser or any cloud service — only the little
# local helper server reads it to talk to your bank.
#
# How to edit: a line starting with # is a disabled note. To turn a
# setting on, remove the # and the space. Values go right after the
# = sign with no quotes and no spaces.
# ============================================================


# ------------------------------------------------------------
# EASIEST PATH: CSV-only mode (no bank connection)
# ------------------------------------------------------------
# Don't want to set up bank sync (yet)? Remove the # from the next
# line and you're done — leave everything else in this file blank.
# You'll import CSV statement files downloaded from your bank instead.
# CSV_ONLY=true


# ------------------------------------------------------------
# TELLER — live bank sync  (required, unless CSV_ONLY=true above)
# ------------------------------------------------------------
# Teller (https://teller.io) is the free service that connects the app
# to your bank. Step by step:
#   1. Go to https://teller.io and click "Sign up" (top right).
#   2. Enter an email + password, verify your email if asked.
#   3. In the dashboard, find your Application ID — a code that starts
#      with "app_" — and copy it.
#   4. Paste it right after the = sign below, like:
#      TELLER_APPLICATION_ID=app_abc123xyz
TELLER_APPLICATION_ID=

# Which Teller mode to use. LEAVE THIS AS sandbox AT FIRST — you get
# fake practice banks so you can try the app risk-free.
#   sandbox     = fake test banks, nothing else needed. Start here!
#   development = your real banks (limited number), certificate required.
#   production  = real banks, certificate required.
TELLER_ENVIRONMENT=sandbox

# Certificate + private key — ONLY needed when you move past sandbox
# to connect real banks. Step by step, when you're ready:
#   1. In the Teller dashboard, find the Certificates section and
#      download the certificate and the private key (two files).
#   2. Save them somewhere permanent, e.g. a folder called
#      "teller-certs" in your home folder (NOT Downloads — you might
#      clean that out later).
#   3. Put the full path to each file below, like:
#      TELLER_CERT_PATH=/Users/yourname/teller-certs/certificate.pem
#      TELLER_KEY_PATH=/Users/yourname/teller-certs/private_key.pem
# Leave both blank while TELLER_ENVIRONMENT=sandbox.
TELLER_CERT_PATH=
TELLER_KEY_PATH=


# ------------------------------------------------------------
# PLAID — OPTIONAL second bank connector. Most people skip this.
# ------------------------------------------------------------
# Only useful if one of your banks isn't supported by Teller. If you
# do want it: sign up at https://plaid.com, then in the dashboard at
# https://dashboard.plaid.com go to Team Settings → Keys and copy the
# client_id and the sandbox/production secret below. Fill in BOTH or
# NEITHER.
PLAID_CLIENT_ID=
PLAID_SECRET=

# Plaid environment: sandbox (fake banks) or production.
PLAID_ENV=sandbox


# ------------------------------------------------------------
# ADVANCED (safe to ignore)
# ------------------------------------------------------------
# Port the local server listens on. Only change this if something
# else on your computer already uses port 4000.
PORT=4000
